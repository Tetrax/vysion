# Copy to .env and adjust. .env is gitignored.

# Host port the application is published on.
VYSION_PORT=8000

# Comma-separated allowed browser origins. Leave empty for the default
# single-container setup, where the UI and API share an origin.
# Example when fronted by a reverse proxy:
#   CORS_ORIGINS=https://vysion.interne.sns-security.fr
CORS_ORIGINS=
