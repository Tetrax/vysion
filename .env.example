# Immutable image reference published by CI: sha-<full commit> of the deployed revision.
IMAGE_TAG=sha-<full commit>
# Published endpoint: BIND_ADDRESS selects the IP, HOST_PORT the port.
# 8080 is the final cutover target, 18080 the temporary validation port.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
REPORT_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=5242880
FORTIGUARD_STATUS_URL=https://www.fortiguard.com/
MEM_LIMIT=512m
CPU_LIMIT=1.0
