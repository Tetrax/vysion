# Immutable image reference published by CI. IMAGE_COMMIT is the full 40-hex
# commit sha of the deployed revision; compose builds the immutable reference
# ghcr.io/tetrax/vysion:sha-<commit> from it, so a mutable tag such as latest
# can never be rendered. Replace the placeholder with `git rev-parse HEAD`.
IMAGE_COMMIT=0000000000000000000000000000000000000000
# Published endpoint: BIND_ADDRESS selects the IP, HOST_PORT the port.
# 8080 is the final cutover target, 18080 the temporary validation port.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
REPORT_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=5242880
FORTIGUARD_STATUS_URL=https://www.fortiguard.com/
MEM_LIMIT=512m
CPU_LIMIT=1.0
