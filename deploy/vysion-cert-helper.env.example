# /etc/vysion/cert-helper.env — read by the systemd unit and by the Certbot
# deploy hook. Not a secret file: it holds names, ids and paths only, so it
# may be world-readable (0644). Never put a credential in here.

# Public name the certificate must match (SAN/hostname check on import).
VYSION_TLS_HOSTNAME=vysion.example

# UID/GID the container runs as (Dockerfile ARGs VYSION_UID/VYSION_GID).
# The helper checks BOTH with SO_PEERCRED before answering anything: a
# process with another uid or gid is refused without a useful reply.
VYSION_PUID=10001
VYSION_PGID=10001

# Private Unix socket, mounted read-only into the container at the same path.
# 0750 root:<VYSION_PGID> for the directory, 0660 root:<VYSION_PGID> for the
# socket: only root and the container can reach it.
HELPER_SOCKET=/run/vysion-cert-helper/helper.sock

# Where the immutable generations live on the host (root-owned, 0700).
HELPER_CERTS_DIR=/var/lib/vysion/certificates

# Optional overrides. A value carrying blanks must be quoted: this file is
# also sourced as shell by the deploy scripts.
#VYSION_CERT_HELPER="python3 -m vysion.certhelper"
#VYSION_PYTHONPATH=/opt/vysion/src
